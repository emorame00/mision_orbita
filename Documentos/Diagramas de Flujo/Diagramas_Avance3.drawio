        <mxCell id="n6" value="1 &lt;= opcion &lt;= len(ACTIVIDADES)" vertex="1" parent="1" style="rhombus;fillColor=#fff2cc;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;strokeColor=#45535c;spacing=4;">
