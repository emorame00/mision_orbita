        <mxCell id="n8" value="recursos[COMBUSTIBLE] &gt;=&#xa;actividad[ACT_COMBUSTIBLE] and&#xa;recursos[ENERGIA] &gt;=&#xa;actividad[ACT_ENERGIA] and&#xa;(recursos[PROVISIONES] &gt;=&#xa;actividad[ACT_PROVISIONES])" vertex="1" parent="1" style="rhombus;fillColor=#fff2cc;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;strokeColor=#45535c;spacing=4;">
